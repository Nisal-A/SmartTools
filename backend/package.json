{
  "name": "@smarttools/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nisal-A/SmartTools.git",
    "directory": "backend"
  },
  "description": "SmartTools Modular Monolith Backend (Express + MongoDB + Puppeteer PDF Engine)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "verify:deploy": "node src/scripts/verifyDeployReadiness.js",
    "test": "node tests/runAllTests.js",
    "test:render": "node tests/verifyRenderReadiness.test.js",
    "test:auth": "node tests/verifyPlatformTask1.test.js",
    "test:history": "node tests/verifyPlatformTask2.test.js",
    "test:invoices": "node tests/verifyInvoicesModule.test.js",
    "test:quotations": "node tests/verifyQuotationsModule.test.js",
    "test:pdf": "node tests/verifyPdfEngine.test.js",
    "test:seo": "node --test tests/seo-analyzer/unit/*.test.js tests/seo-analyzer/integration/*.test.js",
    "test:qa": "node tests/verifyPlatformFinalQA.test.js"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1",
    "multer": "^1.4.5-lts.1",
    "puppeteer": "^23.7.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
