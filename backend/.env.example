PORT=5000
HOST=0.0.0.0
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/smart_tools_db

# Comma-separated allowed frontend origin(s) (trailing slashes trimmed automatically)
CLIENT_URL=http://localhost:5173

# JWT Secrets (generate strong 32+ byte random secrets on Render)
JWT_ACCESS_SECRET=your-secret-key
JWT_REFRESH_SECRET=your-refresh-secret-key

# Initial Admin Seed Credentials
ADMIN_EMAIL=admin@smarttools.dev
ADMIN_PASSWORD=Admin@123456

# Optional keep-alive ping secret for `/api/v1/system/ping` (`x-keepalive-key` header)
KEEPALIVE_SECRET=

# Optional Puppeteer executable override (set automatically to `/usr/bin/chromium` in Docker)
PUPPETEER_EXECUTABLE_PATH=

# Optional Cloudinary credentials (base64 local fallback active when unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SEO Analyzer SSRF Fetcher & Rate Limits
FETCH_TIMEOUT_MS=10000
FETCH_MAX_BYTES=2097152
FETCH_MAX_REDIRECTS=5
RATE_LIMIT_ANALYZE_PER_15MIN=10
RATE_LIMIT_GLOBAL_PER_15MIN=200
