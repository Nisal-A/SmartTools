# =============================================================================
# SmartTools Backend — Environment Template (`backend/.env.example`)
# Copy to `backend/.env` for local development or configure in Render Dashboard.
# =============================================================================

# Runtime & Network
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# MongoDB Atlas / Local Connection (`smart_tools_db`)
# Include `/smart_tools_db` before `?` in your MongoDB Atlas connection string:
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart_tools_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/smart_tools_db

# Allowed Frontend Origin(s) for CORS + Cross-Site Refresh Cookies (comma-separated supported)
# Render example: https://smarttools-frontend.onrender.com
CLIENT_URL=http://localhost:5173

# JWT Secrets (MUST be strong 32+ character random strings in production)
JWT_ACCESS_SECRET=replace-with-at-least-32-char-random-access-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-char-random-refresh-secret

# Cloudinary Asset Storage (Required in production; local base64 fallback only in development)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Render Keep-Alive Ping Secret (`/api/v1/system/ping` -> `x-keepalive-key` header; required in production)
KEEPALIVE_SECRET=replace-with-at-least-16-char-keepalive-secret

# Initial Administrator Bootstrap (`npm --prefix backend run seed:admin`)
ADMIN_EMAIL=admin@smarttools.dev
ADMIN_PASSWORD=ChangeMeStrongAdmin!123

# Optional Puppeteer Chromium Executable Override (set automatically to `/usr/bin/chromium` in Docker)
PUPPETEER_EXECUTABLE_PATH=

# SEO Analyzer SSRF Fetcher & Rate Limits
FETCH_TIMEOUT_MS=10000
FETCH_MAX_BYTES=2097152
FETCH_MAX_REDIRECTS=5
RATE_LIMIT_ANALYZE_PER_15MIN=10
RATE_LIMIT_GLOBAL_PER_15MIN=200
