# =============================================================================
# SmartTools Frontend — Environment Template (`frontend/.env.example`)
# Copy to `frontend/.env` for local overrides or configure on Render Static Site.
# =============================================================================

# Local development uses `/api/v1` (proxied to http://localhost:5000 via Vite).
# On Render Static Site, set to your deployed backend Web Service URL + `/api/v1`:
# VITE_API_BASE_URL=https://smarttools-backend.onrender.com/api/v1
VITE_API_BASE_URL=/api/v1
